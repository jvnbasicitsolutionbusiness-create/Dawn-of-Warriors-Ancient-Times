# Copy to .env; Node loads this server-side only. Never prefix secrets with VITE_.
PORT=3002
DB_PATH=data/dawn.sqlite
# Public HTTPS URL required for production email links.
APP_URL=http://localhost:3002
# Optional comma-separated browser origins when the frontend is hosted separately.
# Set matching origins in auth.html's game-api-origin meta tag.
# CLIENT_ORIGINS=https://game.example.com

# Email verification and account recovery use SMTP.
# Gmail: enable 2-Step Verification, create an App Password, and use:
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_USER=your-address@gmail.com
# SMTP_PASSWORD=your-16-character-app-password
# MAIL_FROM=Dawn of Warriors <your-address@gmail.com>
# Never use your regular Gmail password or commit real mail credentials.
# Without SMTP in development, use the one-click local verification link.

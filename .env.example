# Copy to .env; Node loads this server-side only. Never prefix secrets with VITE_.
PORT=3000
DB_PATH=data/dawn.sqlite
# Public HTTPS URL required for production email links.
APP_URL=http://localhost:3000

# Production registration/recovery requires a working SMTP server.
# Without SMTP in development, messages go to ignored data/mailbox.jsonl.
# A development-only verification link is also shown after registration.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# MAIL_FROM=Dawn of Warriors <noreply@example.com>
